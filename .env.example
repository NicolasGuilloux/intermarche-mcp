# Copy to .env, then fill in. Loaded by `docker compose` (env_file) and by
# `source .env`. Only TWOCAPTCHA_API_KEY and a proxy are strictly required;
# everything else has a sane default.

# ── Required ──────────────────────────────────────────────────────────────────
# 2Captcha API key (https://2captcha.com) — the DataDome solver credit pool.
# Without it the solver errors on the first 403.
#
# The solve REQUIRES a proxy — either a standing one (CAPTCHA_PROXY) or a
# single-use one (CAPTCHA_PROXY_LISTEN below) — so the minted DataDome cid and
# 2Captcha's solve replay share one IP.
TWOCAPTCHA_API_KEY=

# ── Recommended in a container ────────────────────────────────────────────────
# Reuse a configured host's session: point this at a host config dir that has
# already run `intermarche-mcp login`. The container then shares its tokens
# (auth) and its valid DataDome cookie, so orders/basket work and no solve
# credit is spent. Leave empty to use a self-contained named volume instead.
#   macOS: $HOME/Library/Application Support/intermarche-mcp
#   Linux: $HOME/.config/intermarche-mcp
# Why it matters: a cookie minted *inside* a container is often rejected by
# DataDome (see docker/README.md); reusing the host session sidesteps that.
IMT_CONFIG_DIR=

# ── Optional ──────────────────────────────────────────────────────────────────
# Residential proxy for a self-contained container (no IMT_CONFIG_DIR). Used for
# BOTH the DataDome challenge fetch and every API call, so clearance and usage
# share one IP.
# e.g. http://user:pass@host:port
# (Deprecated alias still honoured: IMT_PROXY.)
CAPTCHA_PROXY=

# ── Single-use proxy (alternative to CAPTCHA_PROXY) ───────────────────────────
# Instead of running a standing proxy, this process can serve one itself for
# the length of a solve: it binds CAPTCHA_PROXY_LISTEN, generates fresh
# credentials for that solve alone, only tunnels to the allowed domains, and
# tears the listener down as soon as the solve returns. The API calls then
# egress directly, so both legs share this host's IP.
#
# 2Captcha's workers must be able to reach the listener, and they can only
# speak plaintext CONNECT: exposing it (port forward, tunnel, firewall rule) is
# up to you. CAPTCHA_PROXY_ADVERTISE is the public host:port that reaches it,
# and is what gets handed to 2Captcha. Set it to "ngrok" instead to read the
# address from a running agent (`ngrok tcp 18888`) at each solve — handy since
# ngrok hands out a new random address on every restart. Use
# "ngrok:http://host:port" for an agent API elsewhere than 127.0.0.1:4040.
# Mutually exclusive with CAPTCHA_PROXY.
CAPTCHA_PROXY_LISTEN=
CAPTCHA_PROXY_ADVERTISE=

# ngrok agent credential, read natively by the `ngrok` command: with this in
# your environment, `ngrok tcp 18888` works on any machine without touching
# ~/.config/ngrok/ngrok.yml. Only needed when CAPTCHA_PROXY_ADVERTISE=ngrok.
#   https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=

# ngrok edge region, also read natively by the agent: us (default), eu, ap, au,
# sa, jp, in. Only affects tunnel latency — the solve still egresses from this
# host, which is the IP DataDome binds the clearance to.
NGROK_REGION=eu

# Domains the single-use proxy may tunnel to, comma-separated. Subdomains are
# included. Default: intermarche.com,captcha-delivery.com,ident.me,tnedi.me
# (the last two are how 2Captcha's workers check which IP the proxy gives them
# — drop them and they may consider the proxy broken).
CAPTCHA_PROXY_ALLOW=

# Hard cap on paid solves per run (default 1) — stops a broken-cookie loop from
# draining credits.
CAPTCHA_MAX_SOLVES=1

# Override the Chrome User-Agent sent with API requests (optional).
IMT_USER_AGENT=
